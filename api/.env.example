# Express Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testdrive

# Separate database used only by the automated tests (it is wiped on every run)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/testdrive_test

# Security & Authentication
# Required, at least 32 random characters in production (the server refuses weak or placeholder
# secrets there). Generate one with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_value_before_production_use
JWT_EXPIRES_IN=24h
COOKIE_NAME=td_session

# Web Frontend Origin (for CORS)
WEB_ORIGIN=http://localhost:3000

# Business Rules
CANCELLATION_WINDOW_HOURS=24
MAX_ACTIVE_BOOKINGS=3

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# SMTP Email Configuration (Optional - emails will log to console if omitted)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

